# ============================================================================
# Configuracion de Netplan para Linux Core ({{ core_id | upper }})
# ============================================================================
# Generado automaticamente por Ansible — NO EDITAR A MANO
# ============================================================================

network:
  version: 2
  renderer: networkd
  ethernets:
    {{ nic_fw }}:
      dhcp4: no
    {{ nic_int }}:
      dhcp4: no
      addresses:
        - {{ core_unicast_src_ip }}/30
    {{ nic_trunk2 }}:
      dhcp4: no
{% if bonded_nics is defined and bonded_nics | length >= 2 %}
{% for nic in bonded_nics %}
    {{ nic }}:
      dhcp4: no
      optional: true
{% endfor %}
{% endif %}
{% if bonded_nics is defined and bonded_nics | length >= 2 %}

  bonds:
    bond0:
      interfaces:
{% for nic in bonded_nics %}
        - {{ nic }}
{% endfor %}
      addresses:
        - {{ lan_ip }}
      routes:
        - to: default
          via: {{ lan_gateway }}
        - to: 10.0.0.0/8
          via: {{ lan_gateway }}
      parameters:
        mode: active-backup
        mii-monitor-interval: 100
        primary: {{ bonded_nics[0] }}
{% endif %}

  vlans:
{% for vlan in vlans %}
    v{{ vlan.id }}-fw:
      id: {{ vlan.id }}
      link: {{ nic_fw }}
    v{{ vlan.id }}-trunk2:
      id: {{ vlan.id }}
      link: {{ nic_trunk2 }}
    v{{ vlan.id }}-int:
      id: {{ vlan.id }}
      link: {{ nic_int }}
{% endfor %}

  bridges:
{% for vlan in vlans %}
    br{{ vlan.id }}:
      interfaces:
        - v{{ vlan.id }}-fw
        - v{{ vlan.id }}-trunk2
        - v{{ vlan.id }}-int
      addresses:
        - "{{ vlan.core1_ip if core_id == 'core1' else vlan.core2_ip }}"
      parameters:
        stp: true
        forward-delay: 0
{% endfor %}