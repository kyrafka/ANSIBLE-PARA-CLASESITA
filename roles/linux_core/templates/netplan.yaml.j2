# ============================================================================
# Configuracion de Netplan para Linux Core ({{ core_id | upper }})
# ============================================================================
# Full HA: 2x Trunks + 2x LANs (bonding) + Interlink
# Generado automaticamente por Ansible — NO EDITAR A MANO
# ============================================================================

network:
  version: 2
  renderer: networkd
  ethernets:
    {{ nic_trunk1 }}:
      dhcp4: no
    {{ nic_trunk2 }}:
      dhcp4: no
    {{ nic_int }}:
      dhcp4: no
      addresses:
        - {{ core_unicast_src_ip }}/30
{% if bonded_nics is defined and bonded_nics | length >= 2 %}
{% for nic in bonded_nics %}
    {{ nic }}:
      dhcp4: no
      optional: true
{% endfor %}
{% endif %}
{% if bonded_nics is defined and bonded_nics | length >= 2 %}

  bonds:
    bond0:
      interfaces:
{% for nic in bonded_nics %}
        - {{ nic }}
{% endfor %}
      addresses:
        - {{ lan_ip }}
      routes:
        - to: default
          via: {{ lan_gateway }}
        - to: 10.0.0.0/8
          via: {{ lan_gateway }}
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
      parameters:
        mode: active-backup
        mii-monitor-interval: 100
        primary: {{ bonded_nics[0] }}
{% endif %}

  vlans:
{% for vlan in vlans %}
    v{{ vlan.id }}-trunk1:
      id: {{ vlan.id }}
      link: {{ nic_trunk1 }}
    v{{ vlan.id }}-trunk2:
      id: {{ vlan.id }}
      link: {{ nic_trunk2 }}
    v{{ vlan.id }}-int:
      id: {{ vlan.id }}
      link: {{ nic_int }}
{% endfor %}

  bridges:
{% for vlan in vlans %}
    br{{ vlan.id }}:
      interfaces:
        - v{{ vlan.id }}-trunk1
        - v{{ vlan.id }}-trunk2
        - v{{ vlan.id }}-int
{% if assign_bridge_ips | default(false) | bool %}
      addresses:
        - "{{ vlan.core1_ip if core_id == 'core1' else vlan.core2_ip }}"
{% endif %}
      parameters:
        stp: true
        forward-delay: 4
{% endfor %}