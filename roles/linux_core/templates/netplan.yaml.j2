# ============================================================================
# Configuracion de Netplan para Linux Core ({{ core_id | upper }})
# Simplified: Bond0 (LANs) + Bond1 (Trunks) + Interlink
# Generado automaticamente por Ansible — NO EDITAR A MANO
# ============================================================================

network:
  version: 2
  renderer: networkd
  ethernets:
    ens34:
      dhcp4: no
    ens35:
      dhcp4: no
    ens36:
      dhcp4: no
    ens37:
      dhcp4: no
    ens38:
      dhcp4: no
      addresses:
        - {{ core_unicast_src_ip }}/30
    ens39:
      dhcp4: true
  bonds:
    bond0:
      interfaces:
        - ens34
        - ens35
      addresses:
        - {{ lan_ip }}
      routes:
        - to: default
          via: {{ lan_gateway }}
        - to: 10.0.0.0/8
          via: {{ lan_gateway }}
      nameservers:
        addresses:
          - 8.8.8.8
          - 8.8.4.4
      parameters:
        mode: active-backup
        mii-monitor-interval: 100
        primary: ens34
    bond1:
      interfaces:
        - ens36
        - ens37
      parameters:
        mode: active-backup
        mii-monitor-interval: 100
        primary: ens36