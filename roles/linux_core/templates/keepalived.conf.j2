global_defs {
    router_id {{ core_id }}
    vrrp_version 2
    vrrp_garp_master_delay 1
    vrrp_garp_master_repeat 5
    vrrp_gna_interval 1
    script_user root
    enable_script_security
}

vrrp_script check_bond1 {
    script "/usr/bin/cat /sys/class/net/bond1/operstate | /usr/bin/grep -q up"
    interval 2
    weight 10
    fall 2
    rise 2
}

vrrp_script check_peer_link {
    script "/usr/local/bin/check_peer.sh"
    interval 3
    weight 5
    fall 2
    rise 2
}

{% for vlan in vlans %}
vrrp_instance VI_VLAN{{ vlan.id }} {
    state {{ core_state }}
    interface br{{ vlan.id }}
    virtual_router_id {{ vlan.vrid }}
    priority {{ core_priority }}
    advert_int 1
    {% if core_state == 'BACKUP' %}
    nopreempt
    {% endif %}

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    unicast_src_ip {{ core_unicast_src_ip }}
    unicast_peer {
        {{ core_unicast_peer_ip }}
    }

    track_interface {
        br{{ vlan.id }}
        bond1
    }
    track_script {
        check_bond1
        check_peer_link
    }

    # NOTA: Las VIPs (vlan.vip) NO se asignan aqui.
    # Las VIPs son gestionadas UNICAMENTE por pfSense via CARP.
    # Este Keepalived solo monitorea que los bridges y el interlink esten vivos.
}
{% endfor %}