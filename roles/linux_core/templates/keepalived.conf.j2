global_defs {
    router_id {{ core_id }}
    vrrp_version 2
    vrrp_garp_master_delay 1
    vrrp_garp_master_repeat 5
    vrrp_gna_interval 1
    script_user root
    enable_script_security
}

vrrp_script check_{{ nic_int }} {
    script "/usr/bin/cat /sys/class/net/{{ nic_int }}/operstate | /usr/bin/grep -q up"
    interval 2
    weight 10
    fall 2
    rise 2
}

vrrp_script check_peer_link {
    script "/usr/local/bin/check_peer.sh"
    interval 3
    weight 5
    fall 2
    rise 2
}

{% for vlan in vlans %}
vrrp_instance VI_VLAN{{ vlan.id }} {
    state {{ core_state }}
    interface br{{ vlan.id }}
    virtual_router_id {{ vlan.vrid }}
    priority {{ core_priority }}
    advert_int 1
    {% if core_state == 'BACKUP' %}
    nopreempt
    {% endif %}

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    unicast_src_ip {{ core_unicast_src_ip }}
    unicast_peer {
        {{ core_unicast_peer_ip }}
    }

    track_interface {
        {{ nic_int }}
    }
    track_script {
        check_{{ nic_int }}
        check_peer_link
    }

    virtual_ipaddress {
        {{ vlan.vip }} dev br{{ vlan.id }}
    }
}
{% endfor %}