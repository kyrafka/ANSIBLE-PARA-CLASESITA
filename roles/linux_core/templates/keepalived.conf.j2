global_defs {
    router_id {{ core_id }}
    vrrp_version 2
    vrrp_garp_master_delay 10
    vrrp_garp_master_repeat 3
    vrrp_gna_interval 5
    script_user root
    enable_script_security
    max_auto_priority 10
}

vrrp_script check_interlink {
    script "/usr/local/bin/check_interlink.sh"
    interval 10
    weight -20
    fall 3
    rise 3
}

{% for vlan in vlans %}
vrrp_instance VI_VLAN{{ vlan.id }} {
    state {{ core_state }}
    interface {{ nic_int1 }}
    virtual_router_id {{ vlan.vrid }}
    priority {{ core_priority }}
    advert_int 5
    {% if core_state == 'BACKUP' %}
    nopreempt
    {% endif %}

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    unicast_src_ip {{ core_unicast_src_ip }}
    unicast_peer {
        {{ core_unicast_peer_ip }}
    }

    track_interface {
        br{{ vlan.id }}
    }
    track_script {
        check_interlink
    }

    # NOTA: Las VIPs (vlan.vip) NO se asignan aqui.
    # Las VIPs son gestionadas UNICAMENTE por pfSense via CARP.
}
{% endfor %}