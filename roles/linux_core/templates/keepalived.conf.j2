# ============================================================================
# Configuración Keepalived — {{ core_id | upper }} ({{ core_state }})
# ============================================================================

global_defs {
    router_id {{ core_id }}
    vrrp_version 2
    vrrp_garp_master_delay 1
    vrrp_garp_master_repeat 5
    vrrp_gna_interval 1
    script_user root
    enable_script_security
}

# ---------------------------------------------------------------------------
# VRRP track scripts (Verificación Real de Capa 1/2)
# ---------------------------------------------------------------------------
vrrp_script check_{{ nic_int }} {
    # Usamos /bin/sh -c para que Linux pueda procesar la tubería (|) sin romperse
    script "/bin/sh -c '/bin/cat /sys/class/net/{{ nic_int }}/operstate | /bin/grep -q up'"
    interval 2
    weight 10
    fall 2
    rise 2  # ¡Corregido! Cambiado 'move' por 'rise'
}

# Fallback secundario tirando un ping al vecino por el interlink físico
vrrp_script check_peer_link {
    script "/bin/ping -c 1 -W 2 {{ core_unicast_peer_ip }} > /dev/null 2>&1"
    interval 3
    weight 5
    fall 3
    rise 2
}

# ---------------------------------------------------------------------------
# Instancias VRRP — una por cada VLAN
# ---------------------------------------------------------------------------
{% for vlan in vlans %}
vrrp_instance VI_VLAN{{ vlan.id }} {
    state {{ core_state }}
    interface br{{ vlan.id }}
    virtual_router_id {{ vlan.vrid }}
    priority {{ core_priority }}
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }

    # Los latidos viajan de forma 100% aislada y segura por el cable ens36
    unicast_src_ip {{ core_unicast_src_ip }}
    unicast_peer {
        {{ core_unicast_peer_ip }}
    }

    track_interface {
        {{ nic_int }}
    }
    track_script {
        check_{{ nic_int }}
        check_peer_link
    }

    # La IP virtual flotante de la universidad
    virtual_ipaddress {
        {{ vlan.vip }} dev br{{ vlan.id }}
    }
}
{% endfor %}