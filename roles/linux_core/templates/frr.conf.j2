# ============================================================================
# Configuración FRR (Free Range Routing) para {{ core_id | upper }}
# ============================================================================
# OSPF entre Core 1 y Core 2 vía VLAN 30 (br30)
# ============================================================================

frr version 9.0
frr defaults traditional
!
hostname {{ core_id }}
!
! --- Logging ---
log file /var/log/frr/{{ core_id }}.log
log stdout
log syslog
!
! ============================================================================
! Interfaces
! ============================================================================
{% for vlan in vlans %}
interface {{ vlan.bridge }}
 description {{ vlan.name }}
 ip ospf {{ ospf_area | default('0.0.0.0') }}
 ip ospf cost 10
!
{% endfor %}
! ============================================================================
! Router OSPF
! ============================================================================
router ospf
 ospf router-id {{ core_router_id }}
 passive-interface default
 no passive-interface {{ vlan.interlink_bridge | default('br30') }}
 {% for vlan in vlans -%}
 {% if vlan.id != 30 -%}
 no passive-interface {{ vlan.bridge }}
 {% endif -%}
 {% endfor %}
 network {{ interlink_net | default('192.168.13.0/25') }} area {{ ospf_area | default('0.0.0.0') }}
 {% for vlan in vlans -%}
 network {{ vlan.subnet }} area {{ ospf_area | default('0.0.0.0') }}
 {% endfor %}
!
!
line vty
!
! ============================================================================
! Fin de configuración FRR
! ============================================================================
!