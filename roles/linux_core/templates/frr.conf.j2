# ============================================================================
# Configuración FRR (Free Range Routing) para {{ core_id | upper }}
# ============================================================================

frr version 9.0
frr defaults traditional
!
hostname {{ core_id }}
!
log file /var/log/frr/{{ core_id }}.log
log stdout
log syslog
!
interface bond1
 description Enlace_Directo_Core_Transporte_LACP
 ip ospf {{ ospf_area | default('0.0.0.0') }}
 ip ospf cost 10
!
{% for vlan in vlans %}
interface br{{ vlan.id }}
 description {{ vlan.name }}
 ip ospf {{ ospf_area | default('0.0.0.0') }}
 ip ospf cost 10
!
{% endfor %}
!
router ospf
 ospf router-id {{ core_router_id }}
 passive-interface default
 no passive-interface bond1
 {% for vlan in vlans -%}
 no passive-interface br{{ vlan.id }}
 {% endfor %}
 ! Redes OSPF: Incluye el interlink /30 de transporte y las subnets de las VLANs
 network 10.0.0.0/30 area {{ ospf_area | default('0.0.0.0') }}
 {% for vlan in vlans -%}
 network {{ vlan.subnet }} area {{ ospf_area | default('0.0.0.0') }}
 {% endfor %}
!
line vty
!