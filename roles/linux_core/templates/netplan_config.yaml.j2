network:
  version: 2
  renderer: networkd
  ethernets:
    {{ nic_fw }}:
      dhcp4: no
    {{ nic_int }}:
      dhcp4: no

  vlans:
    # --- VLAN 10 ---
    v10-fw:
      id: 10
      link: {{ nic_fw }}
    v10-int:
      id: 10
      link: {{ nic_int }}
    # --- VLAN 20 ---
    v20-fw:
      id: 20
      link: {{ nic_fw }}
    v20-int:
      id: 20
      link: {{ nic_int }}
    # --- VLAN 21 ---
    v21-fw:
