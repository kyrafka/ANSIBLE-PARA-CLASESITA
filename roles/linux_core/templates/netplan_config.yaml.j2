      link: {{ nic_fw }}
    v21-int:
      id: 21
      link: {{ nic_int }}
    # --- VLAN 30 ---
    v30-fw:
      id: 30
      link: {{ nic_fw }}
    v30-int:
      id: 30
      link: {{ nic_int }}
    # --- VLAN 40 ---
    v40-fw:
      id: 40
      link: {{ nic_fw }}
    v40-int:
      id: 40
      link: {{ nic_int }}
    # --- VLAN 50 ---
    v50-fw:
      id: 50
      link: {{ nic_fw }}
    v50-int:
      id: 50
      link: {{ nic_int }}
    # --- VLAN 60 ---
    v60-fw:
      id: 60
      link: {{ nic_fw }}
    v60-int:
      id: 60
      link: {{ nic_int }}
    # --- VLAN 70 ---
    v70-fw:
      id: 70
      link: {{ nic_fw }}
    v70-int:
      id: 70
      link: {{ nic_int }}

  bridges:
    br10:
      interfaces: [v10-fw, v10-int]
      addresses: [192.168.11.{{ core_ip_suffix }}/27]
